# Telegram Bot Token (from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Space-separated Telegram user IDs of administrators
ADMIN_IDS=123456789 987654321

# Telegram chat ID of the corporation group (negative number for groups)
CORP_CHAT_ID=-1001234567890

# OpenAI API key for the AI agent (optional, leave empty to disable)
OPENAI_API_KEY=

# OpenAI model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Path to SQLite database file
DB_PATH=data/bot.db

# Path to tesseract binary (if not in PATH)
TESSERACT_CMD=tesseract
