# ── Required ──────────────────────────────────────────────────────────────────
# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# The ID of your Discord server (right-click server icon → Copy ID)
GUILD_ID=123456789012345678

# ── OpenAI ─────────────────────────────────────────────────────────────────────
# Get from https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# OCR backend: "openai" (recommended) or "tesseract" (local, less accurate)
OCR_BACKEND=openai

# ── Discord Roles (IDs) ────────────────────────────────────────────────────────
# Role assigned to all registered members
MEMBER_ROLE_ID=0

# Role assigned after screenshot verification
VERIFIED_ROLE_ID=0

# Role that grants admin bot commands
ADMIN_ROLE_ID=0

# Reward roles threshold format: "ISK_threshold:role_id,..."
# Example: members with 100M ISK get role 111, with 1B ISK get role 222
REWARD_ROLES=100000000:111222333444555666,1000000000:777888999000111222

# ── Discord Channels (IDs) ─────────────────────────────────────────────────────
# Channel for registration screenshots
REGISTRATION_CHANNEL_ID=0

# Public kill feed channel
KILLBOARD_CHANNEL_ID=0

# Admin/audit log channel
LOG_CHANNEL_ID=0

# ── Economy ────────────────────────────────────────────────────────────────────
# Ship loss compensation rate (0.8 = 80% of verified ship value)
COMPENSATION_RATE=0.8

# ── Database ───────────────────────────────────────────────────────────────────
DB_PATH=data/weeping_ghosts.db
